{
    "permissions": {
    "allow": [
      "Read(./src/**)",
      "Read(./docs/**)",
      "Read(./package.json)",
      "Read(./.claude/hooks/**)",
      "Read(./.claude/settings.json)",
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/post-edit-checks.sh\"",
            "timeout": 180,
            "statusMessage": "lint / format / typecheck を実行中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-main-push.sh"
          }
        ]
      }
    ]
  }
}
